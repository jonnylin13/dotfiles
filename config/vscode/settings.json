{
  "editor.lineNumbers": "on",
  "editor.fontSize": 12,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "redhat.telemetry.enabled": false,
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
  },
  "security.workspace.trust.untrustedFiles": "open",
  "editor.minimap.autohide": "mouseover",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.inlineSuggest.edits.showCollapsed": true,
  "workbench.editor.revealIfOpen": true,
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "extensions.experimental.affinity": {
    "vscode.vim": 1,
  },
  "vim.smartRelativeLine": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.closeActiveEditor"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.closeOtherEditors"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
    {
      "before": ["<leader>", "s", "h"],
      "commands": ["workbench.action.moveEditorToLeftGroup"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
    {
      "before": ["<leader>", "s", "l"],
      "commands": ["workbench.action.moveEditorToRightGroup"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
    {
      "before": ["<leader>", "f", "h"],
      "commands": ["workbench.action.focusLeftGroup"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
    {
      "before": ["<leader>", "f", "l"],
      "commands": ["workbench.action.focusRightGroup"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
    // Harpoon config
    {
      "before": ["<leader>", "a"],
      "commands": ["vscode-harpoon.addEditor"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["vscode-harpoon.editEditors"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
    {
      "before": ["<leader>", "p"],
      "commands": ["vscode-harpoon.editorQuickPick"],
      "when": "editorTextFocus && vim.mode === 'Normal'",
    },
  ],
  "vim.visualModeKeyBindings": [
    // Enables commenting in visual mode
    {
      "before": ["<leader>", "c"],
      "commands": ["editor.action.commentLine"],
      "when": "editorTextFocus && !editorReadonly",
    },
  ],
  "workbench.colorTheme": "Palenight (Mild Contrast)",
}

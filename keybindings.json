// Place your key bindings in this file to override the defaults
[
  {
    "key": "tab",
    "command": "tab",
    "when": "editorTextFocus && !editorTabMovesFocus && !inlineSuggestionVisible"
  },
  {
    "key": "shift+tab",
    "command": "outdent",
    "when": "editorTextFocus && !editorTabMovesFocus && !inlineSuggestionVisible"
  },
]